{
  "schema": {
    "studio": { "type": "select", "label": "Studio preset", "options": ["neon", "dark_luxe", "abstract_void", "product_softbox", "white_cyc", "daylight"], "default": "neon" },
    "backdrop": { "type": "boolean", "label": "Backdrop (off = transparent, lights only)", "default": true },
    "object": { "type": "select", "label": "Object", "options": ["knot", "ring", "blob", "capsules", "text", "logo"], "default": "knot" },
    "material": { "type": "select", "label": "Material", "options": ["black", "chrome", "iridescent", "glass"], "default": "black" },
    "text": { "type": "text", "label": "Text (object = text)", "default": "NEON" },
    "svg": { "type": "textarea", "label": "Logo SVG markup or URL (object = logo)", "default": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"#fff\"/></svg>" },
    "accent": { "type": "color", "label": "Neon A", "default": "#d4ff3a", "token": "accent" },
    "accent2": { "type": "color", "label": "Neon B", "default": "#7a5cff", "token": "accent-2" },
    "haze": { "type": "number", "label": "Haze", "min": 0, "max": 1, "step": 0.05, "default": 0.35 },
    "spin": { "type": "number", "label": "Turn speed (°/s)", "min": 0, "max": 90, "step": 5, "default": 25 }
  }
}
