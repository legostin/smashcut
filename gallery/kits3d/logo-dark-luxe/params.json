{
  "schema": {
    "studio": {
      "type": "select",
      "label": "Studio preset",
      "options": [
        "dark_luxe",
        "product_softbox",
        "neon",
        "white_cyc",
        "abstract_void",
        "daylight"
      ],
      "default": "dark_luxe"
    },
    "backdrop": {
      "type": "boolean",
      "label": "Backdrop (off = transparent, lights only)",
      "default": true
    },
    "svg": {
      "type": "textarea",
      "label": "Logo SVG markup or URL (one part per path/shape)",
      "default": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 100\"><rect width=\"32\" height=\"100\" rx=\"16\" fill=\"#d4ff3a\"/><circle cx=\"70\" cy=\"25\" r=\"24\" fill=\"#ffffff\"/><path d=\"M62 100A58 58 0 0 1 120 42V100Z\" fill=\"#7a5cff\"/></svg>"
    },
    "finish": {
      "type": "select",
      "label": "Finish",
      "options": [
        "chrome",
        "gold",
        "black",
        "brand"
      ],
      "default": "chrome"
    },
    "depth": {
      "type": "number",
      "label": "Extrusion depth",
      "min": 0.1,
      "max": 1.2,
      "step": 0.05,
      "default": 0.4
    },
    "halo": {
      "type": "color",
      "label": "Wall halo",
      "default": "#ffffff"
    }
  }
}