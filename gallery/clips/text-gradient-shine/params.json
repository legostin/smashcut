{
  "schema": {
    "text": { "type": "textarea", "label": "Headline (one line per row)", "default": "Build the future,\nframe by frame." },
    "badge": { "type": "text", "label": "Badge above (empty = none)", "default": "Introducing Studio 2.0" },
    "subline": { "type": "text", "label": "Subline", "default": "Motion graphics, written as code." },
    "mode": { "type": "select", "label": "Mode", "options": ["sweep", "shine"], "default": "sweep" },
    "gradientStops": { "type": "text", "label": "Gradient colours (comma separated)", "default": "#7f5af0, #2cb1ff, #ff6ad5" },
    "baseColor": { "type": "color", "label": "Base fill (shine mode)", "default": "#aeb2c4" },
    "speed": { "type": "number", "label": "Sweep speed (cycles / s)", "min": 0.02, "max": 1, "step": 0.01, "default": 0.16 },
    "angle": { "type": "number", "label": "Shine band angle (deg)", "min": 60, "max": 160, "step": 1, "default": 110 },
    "font": { "type": "select", "label": "Font", "options": ["Inter", "Manrope", "Unbounded", "Playfair Display"], "default": "Inter" },
    "size": { "type": "number", "label": "Headline size (px)", "min": 60, "max": 240, "step": 2, "default": 150 },
    "glow": { "type": "boolean", "label": "Soft colour glow behind", "default": true },
    "sublineColor": { "type": "color", "label": "Subline colour", "default": "#b4b8c8" }
  }
}
