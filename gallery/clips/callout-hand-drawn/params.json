{
  "schema": {
    "annotations": { "type": "textarea", "label": "Annotations — one per line: \"type: x, y, w, h\" in % of frame (types: circle, underline, box, strike, bracket, highlight, arrow). Optional: #colour, @delay (s)", "default": "highlight: 9, 27, 37, 9\ncircle: 61, 26, 22, 24\nunderline: 9, 47, 26, 5\narrow: 47, 74, 13, -22" },
    "color": { "type": "color", "label": "Marker colour", "default": "#E63946" },
    "highlightColor": { "type": "color", "label": "Highlighter colour", "default": "#FFE066" },
    "highlightOpacity": { "type": "number", "label": "Highlighter opacity", "min": 0.2, "max": 1, "step": 0.05, "default": 0.7 },
    "strokeWidth": { "type": "number", "label": "Stroke width (px)", "min": 2, "max": 24, "step": 1, "default": 8 },
    "roughness": { "type": "number", "label": "Roughness", "min": 0, "max": 3, "step": 0.1, "default": 1 },
    "passes": { "type": "select", "label": "Marker passes (lines & boxes)", "options": ["1", "2"], "default": "2" },
    "drawDuration": { "type": "number", "label": "Draw-on time per mark (s)", "min": 0.2, "max": 2, "step": 0.05, "default": 0.7 },
    "gap": { "type": "number", "label": "Gap between marks (s)", "min": 0, "max": 2, "step": 0.05, "default": 0.3 },
    "startDelay": { "type": "number", "label": "Start delay (s)", "min": 0, "max": 5, "step": 0.05, "default": 0.15 },
    "exitStyle": { "type": "select", "label": "Exit", "options": ["erase", "fade", "none"], "default": "erase" },
    "boil": { "type": "boolean", "label": "Line boil (hand-animated jitter on twos)", "default": false },
    "shadow": { "type": "boolean", "label": "Soft shadow (legibility over footage)", "default": true },
    "seed": { "type": "number", "label": "Seed", "min": 1, "max": 9999, "step": 1, "default": 7 }
  }
}
