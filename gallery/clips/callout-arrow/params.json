{
  "schema": {
    "x": { "type": "number", "label": "Target X (% of width)", "min": 0, "max": 100, "step": 0.5, "default": 64 },
    "y": { "type": "number", "label": "Target Y (% of height)", "min": 0, "max": 100, "step": 0.5, "default": 42 },
    "label": { "type": "text", "label": "Label", "default": "Новая кнопка экспорта" },
    "sublabel": { "type": "text", "label": "Sub-label", "default": "Рендер в MP4 одним кликом" },
    "side": { "type": "select", "label": "Label side", "options": ["auto", "left", "right", "above", "below"], "default": "auto" },
    "distance": { "type": "number", "label": "Label distance (px)", "min": 120, "max": 900, "step": 10, "default": 360 },
    "bend": { "type": "number", "label": "Arrow bend", "min": 0, "max": 1, "step": 0.05, "default": 0.85 },
    "accent": { "type": "color", "label": "Arrow / marker colour", "default": "#ff5a36" },
    "cardColor": { "type": "color", "label": "Card colour", "default": "#ffffff" },
    "cardText": { "type": "color", "label": "Card text colour", "default": "#14161b" },
    "strokeWidth": { "type": "number", "label": "Arrow thickness", "min": 2, "max": 16, "step": 1, "default": 6 },
    "pulse": { "type": "boolean", "label": "Pulsing ring on target", "default": true }
  }
}
