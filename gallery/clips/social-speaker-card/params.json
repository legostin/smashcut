{
  "schema": {
    "eyebrow": {
      "type": "text",
      "label": "Eyebrow",
      "default": "Speaker"
    },
    "name": {
      "type": "text",
      "label": "Name",
      "default": "Anna Kovalenko"
    },
    "role": {
      "type": "text",
      "label": "Role",
      "default": "Art Director, North Studio"
    },
    "talkLabel": {
      "type": "text",
      "label": "Talk label",
      "default": "Talk"
    },
    "talkTitle": {
      "type": "textarea",
      "label": "Talk title",
      "default": "How design systems make video production 10× faster"
    },
    "date": {
      "type": "text",
      "label": "Date (big)",
      "default": "Dec 14"
    },
    "weekday": {
      "type": "text",
      "label": "Date subline",
      "default": "Saturday"
    },
    "time": {
      "type": "text",
      "label": "Time chip",
      "default": "7:00 PM EST"
    },
    "event": {
      "type": "text",
      "label": "Event name",
      "default": "Motion Conf 2026"
    },
    "location": {
      "type": "text",
      "label": "Location / URL",
      "default": "New York · live stream"
    },
    "badge": {
      "type": "text",
      "label": "Rotating sticker text",
      "default": "Free entry"
    },
    "photo": {
      "type": "text",
      "label": "Photo (local path or project asset URL; empty = placeholder)",
      "default": ""
    },
    "palette": {
      "type": "select",
      "label": "Palette",
      "options": [
        "ink",
        "paper",
        "cobalt"
      ],
      "default": "ink"
    },
    "accent": {
      "type": "color",
      "label": "Accent (overrides palette)",
      "default": "#d4ff3a"
    }
  }
}
