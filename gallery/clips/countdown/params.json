{
  "schema": {
    "from": { "type": "number", "label": "Count from", "min": 1, "max": 10, "step": 1, "default": 3 },
    "finalText": { "type": "text", "label": "Final word (empty = none)", "default": "Поехали!" },
    "font": { "type": "select", "label": "Font", "options": ["Unbounded", "Inter", "Manrope", "Bebas Neue"], "default": "Unbounded" },
    "size": { "type": "number", "label": "Number size (px)", "min": 100, "max": 500, "step": 10, "default": 300 },
    "color": { "type": "color", "label": "Number colour", "default": "#ffffff" },
    "accent": { "type": "color", "label": "Ring colour", "default": "#ff3b5c" },
    "accent2": { "type": "color", "label": "Final burst colour", "default": "#ffd426" },
    "disc": { "type": "boolean", "label": "Backing disc", "default": true },
    "discColor": { "type": "color", "label": "Disc colour", "default": "#0e0f15" },
    "discOpacity": { "type": "number", "label": "Disc opacity", "min": 0, "max": 1, "step": 0.05, "default": 0.85 }
