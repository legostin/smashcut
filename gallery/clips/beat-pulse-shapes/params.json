{
  "schema": {
    "bg1": { "type": "color", "label": "Background A", "default": "#0d0a1f" },
    "bg2": { "type": "color", "label": "Background B", "default": "#1d0b2e" },
    "c1": { "type": "color", "label": "Shape colour 1", "default": "#ff4fa3" },
    "c2": { "type": "color", "label": "Shape colour 2", "default": "#5ad7ff" },
    "c3": { "type": "color", "label": "Shape colour 3", "default": "#ffd84f" },
    "density": { "type": "number", "label": "Grid cell size (px, smaller = denser)", "min": 90, "max": 320, "step": 10, "default": 160 },
    "intensity": { "type": "number", "label": "Pulse intensity", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    "decay": { "type": "number", "label": "Pulse decay (higher = snappier)", "min": 1, "max": 20, "step": 0.5, "default": 7 },
    "drift": { "type": "number", "label": "Drift speed", "min": 0, "max": 3, "step": 0.1, "default": 1 },
    "rings": { "type": "boolean", "label": "Shockwave ring on each bar", "default": true },
    "beatsPerBar": { "type": "number", "label": "Beats per bar (fallback)", "min": 2, "max": 8, "step": 1, "default": 4 },
    "seed": { "type": "number", "label": "Random seed", "min": 1, "max": 9999, "step": 1, "default": 3 }
  }
}
