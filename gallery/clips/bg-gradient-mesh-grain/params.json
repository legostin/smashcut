{
  "schema": {
    "palette": {
      "type": "select",
      "label": "Palette",
      "options": [
        "aurora",
        "sunset",
        "ocean",
        "mono-brand",
        "custom"
      ],
      "default": "aurora"
    },
    "color1": {
      "type": "color",
      "label": "Colour 1 (brand colour for mono-brand)",
      "default": "#6d5dfc"
    },
    "color2": {
      "type": "color",
      "label": "Colour 2 (custom)",
      "default": "#ff6ac1"
    },
    "color3": {
      "type": "color",
      "label": "Colour 3 (custom)",
      "default": "#ffb547"
    },
    "color4": {
      "type": "color",
      "label": "Colour 4 (custom)",
      "default": "#2fd5c4"
    },
    "baseColor": {
      "type": "color",
      "label": "Base colour (custom)",
      "default": "#0b0a1a"
    },
    "blobCount": {
      "type": "number",
      "label": "Blobs",
      "min": 3,
      "max": 7,
      "step": 1,
      "default": 5
    },
    "loopSeconds": {
      "type": "number",
      "label": "Loop length (s) — motion repeats seamlessly",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 12
    },
    "motion": {
      "type": "number",
      "label": "Motion amount",
      "min": 0,
      "max": 2,
      "step": 0.05,
      "default": 1
    },
    "softness": {
      "type": "number",
      "label": "Softness (blur)",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.6
    },
    "grainAmount": {
      "type": "number",
      "label": "Grain amount",
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "default": 0.09
    },
    "grainAnimated": {
      "type": "boolean",
      "label": "Animated grain (film) — off = static paper grain",
      "default": true
    },
    "vignette": {
      "type": "number",
      "label": "Vignette",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.35
    },
    "seed": {
      "type": "number",
      "label": "Random seed",
      "min": 1,
      "max": 9999,
      "step": 1,
      "default": 8
    }
  }
}