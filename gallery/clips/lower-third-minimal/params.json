{
  "schema": {
    "name": { "type": "text", "label": "Name", "default": "Maya Lindqvist" },
    "role": { "type": "text", "label": "Role", "default": "Creative Director, Northwind" },
    "position": { "type": "select", "label": "Position", "options": ["left", "center", "right"], "default": "left" },
    "textColor": { "type": "color", "label": "Text colour", "default": "#ffffff" },
    "roleColor": { "type": "color", "label": "Role colour", "default": "#d6dbe4" },
    "lineColor": { "type": "color", "label": "Line colour", "default": "#ffffff" },
    "accent": { "type": "color", "label": "Accent dot", "default": "#3d8bff" },
    "nameSize": { "type": "number", "label": "Name size (px)", "min": 28, "max": 120, "step": 1, "default": 64 },
    "lineWeight": { "type": "number", "label": "Line thickness (px)", "min": 1, "max": 8, "step": 1, "default": 3 },
    "shadow": { "type": "boolean", "label": "Soft shadow", "default": true },
    "outAt": { "type": "number", "label": "Exit duration (s)", "min": 0.3, "max": 2, "step": 0.1, "default": 0.8 }
  }
}
