{
  "schema": {
    "label": { "type": "text", "label": "Block label", "default": "Breaking" },
    "altLabel": { "type": "text", "label": "Alternate label (flips every few seconds, empty = off)", "default": "News" },
    "headline": { "type": "text", "label": "Headline", "default": "Scientists film the birth of an iceberg for the first time" },
    "subheadline": { "type": "text", "label": "Subheadline", "default": "Thwaites Glacier sheds a chunk the size of a city" },
    "location": { "type": "text", "label": "Location tag", "default": "Antarctica" },
    "liveText": { "type": "text", "label": "LIVE bug text (empty = hide)", "default": "Live" },
    "channel": { "type": "text", "label": "Channel logo text (empty = hide)", "default": "24" },
    "startTime": { "type": "text", "label": "Clock start (HH:MM or HH:MM:SS, empty = hide)", "default": "14:32:40" },
    "palette": { "type": "select", "label": "Palette", "options": ["red", "blue", "custom"], "default": "red" },
    "accent": { "type": "color", "label": "Custom accent (palette = custom)", "default": "#e3172b" },
    "navy": { "type": "color", "label": "Secondary bar colour", "default": "#0b1d3a" },
    "flipEvery": { "type": "number", "label": "Label flip interval (s)", "min": 1.5, "max": 10, "step": 0.5, "default": 4 },
    "position": { "type": "select", "label": "Position", "options": ["bottom", "top"], "default": "bottom" }
  }
}
