{
  "schema": {
    "direction": { "type": "select", "label": "Direction", "options": ["up", "down", "left", "right"], "default": "up" },
    "layers": { "type": "number", "label": "Layers", "min": 1, "max": 4, "step": 1, "default": 3 },
    "color1": { "type": "color", "label": "Layer 1 (first in)", "default": "#7cf3d0" },
    "color2": { "type": "color", "label": "Layer 2", "default": "#3b82f6" },
    "color3": { "type": "color", "label": "Layer 3", "default": "#6d28d9" },
    "color4": { "type": "color", "label": "Last layer (covers the cut)", "default": "#0f1024" },
    "points": { "type": "number", "label": "Edge control points", "min": 4, "max": 16, "step": 1, "default": 9 },
    "waviness": { "type": "number", "label": "Waviness", "min": 0, "max": 1, "step": 0.05, "default": 0.7 },
    "stagger": { "type": "number", "label": "Layer stagger (s)", "min": 0, "max": 0.25, "step": 0.01, "default": 0.07 },
    "hold": { "type": "number", "label": "Fully covered hold (s)", "min": 0, "max": 2, "step": 0.05, "default": 0.06 },
    "label": { "type": "text", "label": "Optional text during cover", "default": "" },
    "labelColor": { "type": "color", "label": "Text colour", "default": "#ffffff" },
    "seed": { "type": "number", "label": "Random seed", "min": 1, "max": 9999, "step": 1, "default": 7 }
  }
}
