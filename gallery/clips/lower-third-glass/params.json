{
  "schema": {
    "name": { "type": "text", "label": "Name", "default": "Мария Соколова" },
    "title": { "type": "text", "label": "Title", "default": "Продюсер, подкаст «Тихий час»" },
    "tint": { "type": "color", "label": "Glass tint", "default": "#a9c8ff" },
    "frost": { "type": "number", "label": "Frost strength (glass opacity)", "min": 0, "max": 1, "step": 0.05, "default": 0.55 },
    "accentColor": { "type": "color", "label": "Accent dot", "default": "#5ef2c4" },
    "showAccent": { "type": "boolean", "label": "Show glowing accent dot", "default": true },
    "grain": { "type": "number", "label": "Grain", "min": 0, "max": 0.3, "step": 0.01, "default": 0.12 },
    "position": { "type": "select", "label": "Position", "options": ["left", "center", "right"], "default": "left" },
    "scale": { "type": "number", "label": "Scale", "min": 0.5, "max": 2, "step": 0.05, "default": 1 }
  }
}
