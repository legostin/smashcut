{
  "schema": {
    "text": { "type": "text", "label": "Main text", "default": "open" },
    "subtitle": { "type": "text", "label": "Second line (smaller, second colour)", "default": "all night" },
    "font": { "type": "select", "label": "Font", "options": ["Unbounded", "Manrope", "Playfair Display", "Inter", "JetBrains Mono"], "default": "Unbounded" },
    "size": { "type": "number", "label": "Main size (px)", "min": 60, "max": 320, "step": 2, "default": 210 },
    "color": { "type": "color", "label": "Main neon colour", "default": "#ff3fb4" },
    "color2": { "type": "color", "label": "Second line colour", "default": "#3ee8ff" },
    "glow": { "type": "number", "label": "Glow strength", "min": 0.2, "max": 2, "step": 0.05, "default": 1 },
    "powerOnDuration": { "type": "number", "label": "Power-on duration (s)", "min": 0.3, "max": 3, "step": 0.1, "default": 1.2 },
    "flickerIntensity": { "type": "number", "label": "Flicker intensity", "min": 0, "max": 1, "step": 0.05, "default": 0.7 },
    "faultyLetterIndex": { "type": "number", "label": "Faulty letter index (-1 = none)", "min": -1, "max": 60, "step": 1, "default": 4 },
    "showBacking": { "type": "boolean", "label": "Tube frame around the sign", "default": true },
    "showOffTubes": { "type": "boolean", "label": "Show unlit tubes before power-on", "default": true },
    "seed": { "type": "number", "label": "Flicker seed", "min": 1, "max": 9999, "step": 1, "default": 11 }
  }
}
