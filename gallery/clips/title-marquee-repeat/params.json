{
  "schema": {
    "text": { "type": "text", "label": "Word or phrase", "default": "NEW SEASON" },
    "rows": { "type": "number", "label": "Rows", "min": 3, "max": 11, "step": 1, "default": 7 },
    "font": { "type": "select", "label": "Font (Bebas Neue: Latin only)", "options": ["Unbounded", "Bebas Neue", "Inter", "Manrope", "Playfair Display"], "default": "Unbounded" },
    "uppercase": { "type": "boolean", "label": "Uppercase", "default": true },
    "pattern": { "type": "select", "label": "Fill pattern", "options": ["alternate", "filled", "outline", "accent-only"], "default": "alternate" },
    "speed": { "type": "number", "label": "Scroll speed (px/s)", "min": 0, "max": 800, "step": 10, "default": 150 },
    "waveAmplitude": { "type": "number", "label": "Wave amplitude (px)", "min": 0, "max": 200, "step": 2, "default": 40 },
    "waveFrequency": { "type": "number", "label": "Wave frequency (Hz)", "min": 0, "max": 2, "step": 0.05, "default": 0.25 },
    "emphasis": { "type": "boolean", "label": "Centre row scales up mid-clip", "default": true },
    "background": { "type": "boolean", "label": "Paint background (off = transparent overlay)", "default": true },
    "bgColor": { "type": "color", "label": "Background", "default": "#0e0e10" },
    "color": { "type": "color", "label": "Text colour", "default": "#efece6" },
    "accent": { "type": "color", "label": "Centre row accent", "default": "#c8ff3a" },
    "stroke": { "type": "number", "label": "Outline width (px)", "min": 1, "max": 8, "step": 0.5, "default": 2 }
  }
}
