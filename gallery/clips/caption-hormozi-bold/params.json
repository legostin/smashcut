{
  "schema": {
    "text": { "type": "textarea", "label": "Fallback text (used when there is no transcript)", "default": "Most people quit 3 days before the results show up. Don’t be most people!" },
    "font": { "type": "select", "label": "Font", "options": ["Inter", "Unbounded", "Manrope"], "default": "Inter" },
    "size": { "type": "number", "label": "Font size (px at 1080p)", "min": 48, "max": 200, "step": 2, "default": 118 },
    "uppercase": { "type": "boolean", "label": "Uppercase", "default": true },
    "maxWords": { "type": "number", "label": "Max words per page", "min": 1, "max": 5, "step": 1, "default": 3 },
    "maxChars": { "type": "number", "label": "Max characters per page", "min": 6, "max": 40, "step": 1, "default": 18 },
    "textColor": { "type": "color", "label": "Text colour", "default": "#ffffff" },
    "highlightColor": { "type": "color", "label": "Active word colour", "default": "#ffe500" },
    "altHighlightColor": { "type": "color", "label": "Emphasis word colour", "default": "#3cff5a" },
    "emphasis": { "type": "text", "label": "Emphasis words (comma-separated)", "default": "quit, results" },
    "emphasizeNumbers": { "type": "boolean", "label": "Emphasise numbers automatically", "default": true },
    "strokeWidth": { "type": "number", "label": "Stroke width (px at 1080p)", "min": 0, "max": 24, "step": 1, "default": 12 },
    "shadow": { "type": "boolean", "label": "Drop shadow", "default": true },
    "tilt": { "type": "boolean", "label": "Random tilt per page", "default": false },
    "position": { "type": "select", "label": "Vertical position", "options": ["auto", "lower", "middle", "upper"], "default": "auto" }
  }
}
