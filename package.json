{
  "name": "agent-videostudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first agentic motion graphics & video editor",
  "bin": {
    "agent-videostudio": "bin/studio.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node bin/studio.mjs",
    "server": "tsx server/index.ts",
    "test": "tsx test/smoke.ts",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "playwright-core install chromium-headless-shell",
    "mcp": "node server/mcp/stdio.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "fastify": "^5.12.8",
    "gsap": "^3.15.1",
    "nanoid": "^6.0.2",
    "playwright-core": "^1.65.0",
    "tone": "^15.1.22",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
