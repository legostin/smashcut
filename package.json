{
  "name": "smashcut-studio",
  "version": "0.2.0",
  "description": "Smashcut — open-source AI video production studio. Your AI crew (Claude Code / Codex agents) writes the script and makes motion graphics, music, voice-over, 3D (Blender), tracking and the edit. Local-first, code-based, MCP.",
  "keywords": [
    "ai-video-editor",
    "ai-video",
    "video-editor",
    "motion-graphics",
    "motion-design",
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "model-context-protocol",
    "gsap",
    "tone.js",
    "remotion-alternative",
    "after-effects-alternative",
    "explainer-video",
    "video-generation",
    "text-to-video",
    "blender",
    "object-tracking",
    "storyboard",
    "voiceover",
    "elevenlabs",
    "local-first",
    "open-source"
  ],
  "homepage": "https://legostin.github.io/smashcut/",
  "bugs": {
    "url": "https://github.com/legostin/smashcut/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legostin/smashcut.git"
  },
  "license": "MIT",
  "author": "legostin",
  "type": "module",
  "bin": {
    "smashcut": "bin/studio.mjs",
    "smashcut-studio": "bin/studio.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "web/dist/",
    "runtime/",
    "gallery/",
    "skills/",
    "server/mcp/",
    "server/skeletons/",
    "README.md",
    "README.zh-CN.md",
    "README.ru.md",
    "LICENSE",
    "ATTRIBUTIONS.md"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node bin/studio.mjs",
    "server": "tsx server/index.ts",
    "doctor": "node bin/studio.mjs doctor",
    "test": "tsx test/smoke.ts",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "npm run build",
    "mcp": "node server/mcp/stdio.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@techstark/opencv-js": "^4.10.0-release.1",
    "chokidar": "^6.0.0",
    "fastify": "^5.12.8",
    "gsap": "^3.15.1",
    "nanoid": "^6.0.2",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "tone": "^15.1.22",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
